<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nzt</AssemblyName>
    <RootNamespace>Nzt.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- De acá sale nztVersion en el manifiesto: una sola fuente (I3). -->
    <Version>0.2.0</Version>
    <!-- El contenido canónico vive en la raíz del repositorio, tres niveles arriba. -->
    <ContentRoot>$(MSBuildProjectDirectory)\..\..\..\</ContentRoot>
  </PropertyGroup>

  <!--
    Publicar con un RID es el binario del release (D46): un solo archivo que no
    necesita .NET. Sin trimming: el linker advierte sobre System.Text.Json y
    Spectre.Console, y nada prueba el menú recortado. Sin RID, `dotnet run` y
    las comprobaciones siguen como siempre.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    La única dependencia, y es del menú: los prompts navegables con flechas.
    El reporte sigue siendo Console, sin markup.
  -->
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <!--
    El contenido va embebido: un solo artefacto, sin resolver rutas del repo en
    tiempo de ejecución, y la versión del CLI es la versión del set que instala.
    LogicalName conserva la ruta relativa para poder reconstruir el árbol y
    derivar de él el nombre plano de cada skill (9.1).
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(ContentRoot)core\**\*.md">
      <LogicalName>content/core/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ContentRoot)skills\**\SKILL.md">
      <LogicalName>content/skills/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
